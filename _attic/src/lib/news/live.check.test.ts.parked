/** 临时联通性验证（跑完即删，不留在仓库里） */
import { describe, expect, it } from 'vitest';

import { articleUrl, fetchNewsItems, NEWS_LIMIT } from './miyoushe';

describe('真实网络联通性', () => {
  it('公告端点能拉到 5 条真实数据', async () => {
    const items = await fetchNewsItems('notice', NEWS_LIMIT);
    console.log('notice:', JSON.stringify(items, null, 2));
    expect(items.length).toBe(5);
    expect(items[0]?.title.length).toBeGreaterThan(0);
    expect(items[0]?.createdAt).toBeGreaterThan(1_600_000_000);
  }, 30_000);

  it('资讯端点能拉到 5 条真实数据', async () => {
    const items = await fetchNewsItems('news', NEWS_LIMIT);
    console.log('news:', JSON.stringify(items, null, 2));
    expect(items.length).toBe(5);
  }, 30_000);

  it('原文链接返回 200', async () => {
    const items = await fetchNewsItems('notice', 1);
    const response = await fetch(articleUrl(items[0]!.id), { method: 'GET' });
    console.log('article status:', response.status, articleUrl(items[0]!.id));
    expect(response.status).toBe(200);
  }, 30_000);
});
