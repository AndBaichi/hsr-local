{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "星穹铁道数据库",
  "version": "4.9.0",
  "identifier": "com.hsr.local.databank",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420/",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "星穹铁道数据库",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "center": true,
        "decorations": false,
        "shadow": true,
        "backgroundColor": "#0B0E14",
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/packs/**", "$APPDATA/notes/**"]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc4NDA2RjI0NkFDRTU0NDQKUldSRVZNNXFKRzlBZVBQYUxaTEF4QkU4R2Y4VTQ0MlJKRVM2K2xFZjlZUVpjYkU5NndrWHdnNzEK",
      "endpoints": [
        "https://github.com/AndBaichi/hsr-local/releases/download/app-latest/latest.json"
      ]
    }
  },
  "bundle": {
    "createUpdaterArtifacts": true,
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../hsr-local-builtin.hsrpack": "hsr-local-builtin.hsrpack"
    },
    "windows": {
      "nsis": {
        "compression": "none",
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "languages": ["SimpChinese", "English"]
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    }
  }
}
