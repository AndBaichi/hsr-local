{
    "name":  "hsr-local",
    "private":  true,
    "version":  "4.8.0",
    "type":  "module",
    "description":  "星穹数据库 · 本地版 —— 完全离线的崩坏：星穹铁道本地资料库",
    "license":  "MIT",
    "scripts":  {
                    "dev":  "vite",
                    "build":  "tsc -p tsconfig.json --noEmit \u0026\u0026 vite build",
                    "preview":  "vite preview",
                    "typecheck":  "tsc -p tsconfig.json --noEmit \u0026\u0026 tsc -p tsconfig.node.json --noEmit",
                    "test":  "vitest run",
                    "datapack":  "node scripts/build-datapack.mjs",
                    "datapack:lists":  "node scripts/build-datapack.mjs --stage lists",
                    "datapack:validate":  "node scripts/build-datapack.mjs --stage validate",
                    "datapack:full":  "node scripts/build-datapack.mjs --stage lists,inspect,details,images,build,validate \u0026\u0026 node scripts/build-extra-modules.mjs \u0026\u0026 node scripts/repack.mjs",
                    "datapack:repack":  "node scripts/repack.mjs",
                    "update:check":  "node scripts/detect-upstream-version.mjs",
                    "update:manifest":  "node scripts/make-update-manifest.mjs",
                    "tauri":  "node scripts/with-mingw.mjs tauri",
                    "tauri:dev":  "node scripts/with-mingw.mjs tauri dev",
                    "tauri:build":  "node scripts/with-mingw.mjs tauri build",
                    "selftest":  "cd src-tauri \u0026\u0026 node ../scripts/with-mingw.mjs cargo run --bin selftest",
                    "lint":  "eslint src"
                },
    "dependencies":  {
                         "@emotion/react":  "^11.14.0",
                         "@emotion/styled":  "^11.14.0",
                         "@mui/icons-material":  "^7.3.0",
                         "@mui/material":  "^7.3.0",
                         "@tanstack/react-virtual":  "^3.13.0",
                         "@tauri-apps/api":  "^2.9.0",
                         "@tauri-apps/plugin-dialog":  "^2.4.0",
                         "@tauri-apps/plugin-opener":  "^2.5.0",
                         "@tauri-apps/plugin-process":  "^2.4.0",
                         "@tauri-apps/plugin-updater":  "^2.14.1",
                         "i18next":  "^25.0.0",
                         "react":  "^19.2.0",
                         "react-dom":  "^19.2.0",
                         "react-i18next":  "^15.0.0",
                         "react-router-dom":  "^7.9.0",
                         "zustand":  "^5.0.0"
                     },
    "devDependencies":  {
                            "@eslint/js":  "^10.0.1",
                            "@tauri-apps/cli":  "^2.9.0",
                            "@types/node":  "^22.10.0",
                            "@types/react":  "^19.2.0",
                            "@types/react-dom":  "^19.2.0",
                            "@vitejs/plugin-react":  "^4.3.0",
                            "autoprefixer":  "^10.4.20",
                            "eslint":  "^10.15.0",
                            "eslint-plugin-react-hooks":  "^7.1.1",
                            "globals":  "^17.14.0",
                            "postcss":  "^8.4.49",
                            "tailwindcss":  "^3.4.17",
                            "tsx":  "^4.19.0",
                            "typescript":  "^5.7.0",
                            "typescript-eslint":  "^8.73.0",
                            "vite":  "^7.1.0",
                            "vitest":  "^3.0.0"
                        }
}
