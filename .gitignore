# 依赖与构建产物
node_modules/
dist/
dist-ssr/

# Tauri / Rust
src-tauri/target/
src-tauri/gen/

# 数据包（80MB+，由 scripts/build-datapack.mjs 生成，不进版本库）
public/datapack/
/data/
*.hsrpack
datapack-report.json
update.json
scripts/build.log
.cache/

# 日志与临时文件
*.log
npm-debug.log*
.npm/
*.local
*.tmp
*.bak

# 编辑器 / 系统
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# 本地归档（只留在本机，不随仓库分发）
_attic/

# WorkBuddy 本地记忆/会话状态
.workbuddy/

# Tauri 更新签名私钥（绝不进仓库）
*.key
*.key.pub

# 由构建/发布脚本生成
latest.json

# 发布脚本生成在仓库根目录的安装包副本（不入库）
hsr-local_*-setup.exe
hsr-local_*-setup.exe.sig

# 安装包内置数据包（由 prepare-builtin-pack.mjs 复制）
hsr-local-builtin.hsrpack
src-tauri/builtin-pack-id.txt
